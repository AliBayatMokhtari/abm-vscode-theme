  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "comment.block.documentation"],
      "settings": { "foreground": "#7A8199", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#8FBF82" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character.escape", "constant.other.color.rgb-value.hex", "constant.other.color.rgb-value", "support.constant"],
      "settings": { "foreground": "#D8956C" }
    },
    {
      "scope": ["keyword.other.unit"],
      "settings": { "foreground": "#D8956C" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#A486D6" }
    },
    {
      "scope": ["keyword.control", "keyword.control.flow", "keyword.control.loop", "keyword.control.conditional", "keyword.control.import", "keyword.control.export", "keyword.control.from", "keyword.control.return", "keyword.control.default", "keyword.control.trycatch", "keyword.control.as"],
      "settings": { "foreground": "#A486D6", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#8B93AC" }
