      "scope": ["constant.numeric", "constant.language", "constant.character.escape", "constant.other.color.rgb-value.hex", "constant.other.color.rgb-value", "support.constant"],
      "settings": { "foreground": "#B491F2" }
    },
    {
      "scope": ["keyword.other.unit"],
      "settings": { "foreground": "#B491F2" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#F381C0" }
    },
    {
