    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#A59A8C" }
    },
    {
      "scope": ["entity.name.function", "support.function", "variable.function"],
      "settings": { "foreground": "#E08B55" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.name.type.class", "entity.name.type.interface", "entity.name.type.enum", "entity.name.type.instance", "support.class", "support.type", "entity.other.inherited-class", "entity.name.type.module"],
